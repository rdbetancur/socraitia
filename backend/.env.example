# Local development uses Application Default Credentials:
#   gcloud auth application-default login
# On Cloud Run these come from the service account instead, and none of this
# file is needed.

GOOGLE_CLOUD_PROJECT=socraitia
FIRESTORE_DATABASE=socraitia

# Gemini 3.x is ONLY served from the global endpoint. us-central1 returns 404.
GEMINI_LOCATION=global
# Veo is ONLY served from us-central1.
VEO_LOCATION=us-central1

MODEL_SOCRATIC=gemini-3.5-flash
MODEL_CARTOGRAPHER=gemini-3.5-flash
MODEL_VERIFIER=gemini-3.5-flash
MODEL_EMBEDDING=gemini-embedding-2
EMBEDDING_DIM=768
MODEL_VEO=veo-3.1-fast-generate-001

DEMO_UID=demo-researcher
DEMO_PROJECT_ID=ai-in-education

AGENT_TIMEOUT_S=60
CONTEXT_RECENT_EXCHANGES=6
CONTEXT_GRAPH_TOP_K=18
ENABLE_EMBEDDINGS=true

CORS_ORIGINS=http://localhost:3000
